{
  "name": "burnbox",
  "version": "0.1.0",
  "description": "Burn Box: send us the file you're afraid to open. A detonation chamber for small teams, on Vultr.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": { "node": ">=22.18" },
  "scripts": {
    "start": "node server/src/index.ts",
    "dev": "STUB_LLM=1 BOX_IMAGE=burnbox-box:dev node --watch server/src/index.ts",
    "check": "tsc --noEmit",
    "test": "node --test server/test/*.test.ts",
    "build:box": "docker build -t burnbox-box:latest sandbox/box"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
