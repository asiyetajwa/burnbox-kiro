# Copy to .env on the host. Never commit .env.
# Inference: Gemini through its OpenAI-compatible endpoint. The VULTR_* names are kept from the original build.
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
VULTR_MODEL=gemini-2.5-flash
STUB_LLM=0
SANDBOX_RUNTIME=
PUBLIC_PORT=80
RUNS_PER_HOUR=30
MAX_CONCURRENT_RUNS=2
# Forward It To Burn Box: set a domain whose MX record points at this VM; mail to check@MAIL_DOMAIN becomes an email run.
MAIL_DOMAIN=
